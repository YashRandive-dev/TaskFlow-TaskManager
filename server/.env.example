# ---------- Server ----------
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# ---------- Auth (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----------
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
MAX_DEVICES=5
AUTH_RATE_LIMIT=40

# ---------- Email (optional: without SMTP_HOST, codes and emails print in the server console) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TaskFlow <no-reply@yourdomain.com>"

# ---------- Cloudinary (optional: without it, uploads are saved in server/uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
